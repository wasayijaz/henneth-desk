---
/* =============================================================================================
   MATRIX — a comparison table that survives a phone.

   A plain <table> in an explainer is where mobile readability dies: it either overflows the
   viewport or squeezes columns to unreadable width. This renders as a table on desktop and
   restacks into labelled cards below 700px, so the same data works on the device most PSX
   readers actually use.

   Cell values are indexable text, not an image of a table — which is also what lets an LLM read
   and cite the comparison.
   ============================================================================================= */

interface Props {
  cols: string[];
  rows: (string | { v: string; tone?: 'up' | 'dn' | 'muted' })[][];
  caption?: string;
}

const { cols, rows, caption } = Astro.props;
const cell = (c: (typeof rows)[number][number]) => (typeof c === 'string' ? { v: c, tone: '' } : c);
---

<figure class="mx">
  <table class="mx-t">
    <thead>
      <tr>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            {r.map((c, i) => {
              const x = cell(c);
              return i === 0 ? (
                <th scope="row" data-l={cols[i]}>
                  {x.v}
                </th>
              ) : (
                <td class={x.tone || ''} data-l={cols[i]}>
                  {x.v}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
  {caption && <figcaption class="mx-cap">{caption}</figcaption>}
</figure>

<style>
  .mx { margin: 0 0 28px; border: var(--rule); background: var(--panel); }
  .mx-t { width: 100%; border-collapse: collapse; font-size: 12px; }
  .mx-t th, .mx-t td { padding: 10px 14px; text-align: left; border-bottom: 1px dotted var(--hair); }
  .mx-t thead th {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    background: var(--ink-1); color: var(--bg); border-bottom: 0; font-weight: 700;
  }
  .mx-t tbody th { font-weight: 600; color: var(--ink-1); }
  .mx-t tbody td { color: var(--ink-2); font-family: var(--font-mono); font-size: 11.5px; }
  .mx-t tbody tr:last-child th, .mx-t tbody tr:last-child td { border-bottom: 0; }
  /* `tbody` in the selector is load-bearing: without it these lose to `.mx-t tbody td` above,
     which sets colour, and every toned cell silently renders as plain body text — the tone class
     is applied in the markup but does nothing visible. */
  .mx-t tbody td.up { color: var(--up); font-weight: 700; }
  .mx-t tbody td.dn { color: var(--dn); font-weight: 700; }
  .mx-t tbody td.muted { color: var(--ink-3); }

  .mx-cap { font-size: 10.5px; color: var(--ink-3); line-height: 1.6; padding: 12px 14px; border-top: var(--rule); }

  /* Restack, rather than scroll. A horizontally-scrolling table hides columns behind a gesture
     most readers never try, so the comparison silently loses half its cells on mobile. */
  @media (max-width: 700px) {
    .mx-t thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .mx-t tr { display: block; border-bottom: var(--rule); padding: 4px 0; }
    .mx-t tr:last-child { border-bottom: 0; }
    .mx-t tbody th { display: block; padding: 10px 14px 4px; font-size: 13px; }
    .mx-t tbody td { display: block; border-bottom: 0; padding: 4px 14px 8px; overflow-wrap: anywhere; }
    .mx-t tbody td::before {
      content: attr(data-l); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.09em;
      text-transform: uppercase; color: var(--ink-3); display: block; margin-bottom: 3px;
    }
  }
  /* Below 700px the header row is hidden and its text is re-drawn per cell as ::before — so on a
     phone that pseudo-element IS the column heading, and 9px is far too small for the only label
     telling you what the number beside it means. Ordered after the 700px block so it wins. */
  @media (max-width: 720px) {
    .mx-t tbody td { font-size: 12.5px; }
    .mx-t tbody td::before { font-size: 11px; }
    .mx-cap { font-size: 12.5px; }
  }
</style>
