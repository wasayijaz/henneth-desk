---
import { site } from '../site.config.ts';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features/', label: 'Features' },
      { href: '/solutions/', label: 'Solutions' },
      /* The ONLY site-wide inbound link to /psx/ — the hub every one of the 19 ticker pages
         hangs off (their breadcrumb points back up to it, but nothing pointed down). Without a
         link from outside its own children a hub carries no crawl authority to pass on, which is
         exactly why GSC was showing all 19 ticker pages as "Discovered - currently not indexed".
         Same fix already applied to /global-markets below; this closes the matching gap. */
      { href: '/psx/', label: 'PSX companies' },
      /* Sits under Product, not Resources: global coverage is part of what the subscription is,
         not a reading-room extra. It is also the only site-wide link to /global-markets/ — the nav
         deliberately stays at seven items, so the footer carries the crawl path. */
      { href: '/global-markets/', label: 'Global coverage' },
      { href: '/compare/', label: 'Compare tools' },
      { href: '/plans/', label: 'Plans' },
    ],
  },
  /* The use-case pages are listed here AND in the Solutions nav, deliberately. A page built to
     rank but reachable only from a footer is the doorway pattern Google targets — if it is worth
     ranking it is worth navigating to. This column also does the internal-linking job: it points
     site-wide authority at the pages that actually convert. */
  {
    title: 'Use cases',
    links: [
      { href: '/solutions/psx-research-for-new-investors/', label: 'New investors' },
      { href: '/solutions/psx-screener-and-strategies/', label: 'Screener & strategies' },
      { href: '/solutions/psx-dividend-calendar-and-yields/', label: 'Dividend calendar & yields' },
      { href: '/solutions/psx-broker-research-scorecard/', label: 'Brokers & institutions' },
      { href: '/solutions/psx-company-fair-value/', label: 'Company fair value' },
      { href: '/solutions/psx-market-today/', label: 'Market today' },
      { href: '/solutions/psx-astrology-market-lens/', label: 'Astrology market lens' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/research/', label: 'Research' },
      { href: '/financial-astrology/', label: 'Financial astrology' },
      { href: '/blog/', label: 'Blog' },
      { href: '/tools/', label: 'Calculators' },
      /* Deep-linked past /tools on purpose. It is the one free page that demonstrates a house rule
         (Rule 4 sizing) rather than describing one, so it is the highest-intent entry point on the
         site for someone who has not signed up. */
      { href: '/tools/position-size-calculator/', label: 'Position size calculator' },
      { href: '/about/', label: 'About' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/legal/terms/', label: 'Terms' },
      { href: '/legal/privacy/', label: 'Privacy' },
      { href: '/legal/disclosures/', label: 'Disclosures' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap ft-in">
    <div class="ft-brand">
      <a href="/" class="wordmark">
        <span class="wm-1">HENNETH</span>
      </a>
      <p class="ft-blurb">
        A research &amp; analytics desk that covers the Pakistan Stock Exchange in depth and the
        global tape for context. Plain-English company reads, backtested strategies, and analysts
        who debate every name in the open — published on a schedule.
      </p>
      <a href="/plans" class="btn ft-cta">Get started</a>
      <div class="ft-social">
        <a href="https://x.com/hennethapp" class="ft-social-link" target="_blank" rel="noopener noreferrer" aria-label="Henneth on X">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M18.9 2.1h3.2l-7 8.1L23.4 22h-6.5l-5.1-6.7L5.9 22H2.7l7.5-8.6L1.6 2.1h6.6l4.6 6.1zm-1.1 18h1.8L6.3 4h-1.9z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/henneth.app/" class="ft-social-link" target="_blank" rel="noopener noreferrer" aria-label="Henneth on Instagram">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5"/>
            <circle cx="12" cy="12" r="4.6"/>
            <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </div>

      <div class="ft-ext">
        <a href="https://chromewebstore.google.com/detail/henneth-desk-companion/jclcndmmhcaheafpijahmdlhljoadjnb" class="btn ft-ext-cta" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z" />
          </svg>
          Get the Chrome extension
        </a>
        <p class="ft-ext-note">Needs a free Henneth account &mdash; takes 2 min. <a href="/plans">Create one now &rarr;</a></p>
      </div>
    </div>

    {cols.map((c) => (
      <div class="ft-col">
        <div class="ft-h">{c.title}</div>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap ft-base">
    <div class="ft-base-text">
      <p>
        {site.name} is an educational research &amp; analytics tool — not an investment adviser, not a
        broker. Nothing here is personalised advice, a recommendation, or a promise of returns. Past
        performance does not predict future results. Investing in the Pakistan Stock Exchange carries
        risk, including the loss of capital. You make your own decisions.
      </p>
      <p class="ft-copy">© {year} {site.name}. All rights reserved.</p>
    </div>

    <a
      href="https://www.producthunt.com/products/henneth-app?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-henneth-app"
      target="_blank" rel="noopener noreferrer" class="ft-ph" aria-label="Henneth App on Product Hunt"
    >
      <img
        alt="Henneth App - A research terminal for the Pakistan Stock Exchange | Product Hunt"
        width="150" height="32"
        src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1224856&theme=light&t=1787578248445"
      />
    </a>
  </div>
</footer>

<style>
  .ft { background: var(--ink-1); color: var(--bg); padding: 56px 0 24px; }
  .ft-in {
    display: grid;
    /* Brand + four link columns. Was 1.5fr and three; a fourth column was added for the use-case
       pages, and without widening this the last column wrapped. */
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
  }
  .wordmark { display: flex; align-items: baseline; gap: 8px; color: var(--bg); text-decoration: none; }
  .wm-1 { font-weight: 800; font-size: 15px; letter-spacing: 0.14em; }
  .ft-blurb { margin: 14px 0 18px; font-size: 11.5px; line-height: 1.7; color: #a8a8a0; max-width: 320px; }
  .ft-cta { padding: 10px 16px; }
  .ft-social { display: flex; gap: 10px; margin-top: 18px; }

  .ft-ext { margin-top: 22px; }
  .ft-ph { display: inline-block; line-height: 0; flex-shrink: 0; }
  .ft-ph img { display: block; max-width: 100%; height: auto; }
  .ft-ext-cta { padding: 10px 16px; }
  .ft-ext-cta svg { flex-shrink: 0; }
  .ft-ext-note { margin: 10px 0 0; font-size: 11px; line-height: 1.6; color: #a8a8a0; max-width: 280px; }
  .ft-ext-note a { color: #cfcfc8; text-decoration: underline; }
  @media (hover: hover) {
    .ft-ext-note a:hover { color: var(--bg); }
  }
  .ft-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid #3a3a35;
    color: #cfcfc8;
    text-decoration: none;
  }
  @media (hover: hover) {
    .ft-social-link:hover { color: var(--bg); border-color: #5a5a52; }
  }
  /* On touch screens the 32px box is under the 44px minimum tap target, so a thumb
     misses it. Widen the box itself on coarse pointers — the desktop 32px look is
     unchanged because pointer:fine never matches this rule. */
  @media (pointer: coarse) {
    .ft-social-link { width: 44px; height: 44px; }
  }

  .ft-h {
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 700;
    color: #8f8f88;
    margin-bottom: 14px;
  }
  .ft-col ul { list-style: none; margin: 0; padding: 0; }
  .ft-col li { margin-bottom: 10px; }
  .ft-col a {
    color: #cfcfc8;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* var(--bg), not #fff: the site's paper white is not pure white, and one hover state that jumps
     past it is the kind of half-degree difference that reads as a rendering bug. */
  @media (hover: hover) {
    .ft-col a:hover { color: var(--bg); }
  }

  .ft-base {
    border-top: 1px solid #2a2a27; padding-top: 20px;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 32px;
  }
  /* #8f8f88, not #7a7a72. This paragraph is the risk disclaimer — the one block on the site that
     has to be legible on principle, and it was the least legible thing on it. */
  .ft-base p { font-size: 10px; line-height: 1.7; color: #8f8f88; margin: 0 0 8px; max-width: 900px; }
  .ft-copy { margin: 0; }

  @media (max-width: 860px) {
    /* Five items into two columns leaves Legal alone on a row with a hole beside it. The brand
       block takes the full width instead, so the four link columns pair off 2 + 2. */
    .ft-in { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
    .ft-blurb { max-width: 60ch; }
  }
  @media (max-width: 520px) {
    .ft-in { grid-template-columns: 1fr; gap: 26px; }
  }
  @media (max-width: 640px) {
    .ft-base { flex-direction: column; align-items: flex-start; gap: 18px; }
  }

  /* The footer carries seventeen links, and on a phone every one of them was an 11px word 14px
     tall — the densest cluster of unhittable targets on the site. Each link becomes its own 44px
     row instead, which is why the li margin goes to zero: the row supplies the spacing now. */
  @media (max-width: 720px) {
    .ft { padding: 44px 0 24px; }
    .ft-h { font-size: 11px; margin-bottom: 6px; }
    .ft-blurb { font-size: 13px; }
    .ft-col li { margin-bottom: 0; }
    .ft-col a {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: 12px;
    }
    .ft-base p { font-size: 11.5px; }
    /* Stacked, the wordmark becomes a full-width row — so it reads as a big target while actually
       being 25px of it. align-self keeps the box from stretching to the column width it does not
       need; the height is what was missing. */
    .wordmark { min-height: 44px; align-items: center; align-self: start; }
  }
</style>
