---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Compare PSX research tools"
  path="/compare/"
  description="Compare public PSX data, screeners, portfolio tools and research publications by the job each one does."
>
  <section class="section-tight">
    <div class="wrap compare-home">
      <p class="kicker">Compare</p>
      <h1>Choose the research tool for the question you have</h1>
      <p class="lead">Market data, screening, portfolio tracking and published research solve different problems. Start with the public, source-linked comparison below.</p>
      <a class="btn btn-solid" href="/compare/psx-research-tools/">Compare PSX research tools</a>
      <p class="note">Henneth is included in the comparison. It is a research publication, not a broker.</p>
    </div>
  </section>
</Base>

<style>
  .compare-home { max-width: 840px; }
  .compare-home .lead { max-width: 680px; }
  .note { color: var(--ink-3); font-size: 12px; margin-top: 18px; }
</style>
