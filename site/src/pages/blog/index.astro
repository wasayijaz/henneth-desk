---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site.config.ts';
import { getCollection } from 'astro:content';
import { CLUSTERS } from '../../content.config.ts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
/* Derived from the schema's CLUSTERS rather than hand-listed. The hand-written version had drifted:
   it offered 4 of the 6 clusters the schema knows, so a post tagged Macro or Astro rendered fine
   and was unreachable from every chip. Only clusters that actually have posts are shown, so the
   filter never offers a chip that leads to an empty grid. */
const used = new Set(posts.map((p) => p.data.cluster).filter(Boolean));
const cats = ['All', ...CLUSTERS.filter((c) => used.has(c))];

/* Cluster -> sprite id. Falls back to the compass ("method") for a cluster the SEO agent invents
   later, so an unmapped value degrades to a sensible mark instead of a broken <use> ref. */
const CLUSTER_ICON: Record<string, string> = {
  Valuation: 'value',
  'Market structure': 'board',
  Method: 'method',
  Sectors: 'sectors',
  Astro: 'astro',
  Macro: 'macro',
};
const iconFor = (c?: string) => CLUSTER_ICON[c ?? ''] ?? 'method';

/* Reading time from the raw body. 200 wpm is the conventional prose rate; this is deliberately
   computed rather than a frontmatter field, so a writer cannot forget it or get it wrong, and it
   updates automatically when a post is edited. */
const readMins = (body?: string) => Math.max(1, Math.round((body ?? '').split(/\s+/).length / 200));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-PK', { year: 'numeric', month: 'short', day: 'numeric' });

// The newest post gets the wide treatment; everything after it goes in the grid.
const [featured, ...rest] = posts;
---

<Base
  title="PSX blog — reading and valuing companies"
  crumbLeaf="Blog"
  path="/blog"
  active="blog"
  description="Plain-English writing on the Pakistan Stock Exchange — how to read a company, value it, and think about risk."
>
  <section class="section-tight ph">
    <div class="wrap">
      <p class="kicker">Blog</p>
      <h1>The market, explained</h1>
      <p class="lead ph-lead">
        Plain-English writing on reading PSX companies, valuing them, and thinking clearly about
        risk.
      </p>
    </div>
  </section>

  <section class="wrap">
    <a class="beginner-path" href="/start/">
      <span class="beginner-mark"><Icon name="method" size={20} /></span>
      <span class="beginner-copy"><strong>New to PSX? Start with the questions.</strong><small>Risk, brokers, diversification, company accounts and what moves the market — in a useful order.</small></span>
      <Icon name="arrow" size={16} />
    </a>
    <div class="chips">
      {cats.map((c, i) => <button class:list={['chip', { on: i === 0 }]} data-cat={c}>{c}</button>)}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      {posts.length === 0 ? (
        /* The empty state does real work: this page will be indexed before the first post ships,
           so it states what is coming and in which clusters rather than showing a bare box. */
        <div class="empty-wrap">
          <div class="card empty">
            <span class="badge"><span class="dot"></span>Writing in progress</span>
            <h2>The first pieces are being written</h2>
            <p class="muted empty-p">
              Clear, honest explainers on how to read PSX companies and sectors — the kind of thing
              we wish existed when we started. No tips, no targets, no “top 5 shares to buy”.
            </p>
          </div>
          <div class="tilegrid planned">
            {cats.slice(1).map((c) => (
              <div class="tile">
                <span class="tile-i"><Icon name={iconFor(c)} size={20} /></span>
                <h3>{c}</h3>
                <p class="muted card-d">
                  {c === 'Valuation' && 'What a company is worth, four ways — and why the methods disagree.'}
                  {c === 'Market structure' && 'How PSX actually works: settlement, circuit breakers, liquidity, free float.'}
                  {c === 'Method' && 'How to test an idea before you trust it, and how to read a backtest honestly.'}
                  {c === 'Sectors' && 'What drives banks, cements, fertilisers, E&Ps and the rest of the exchange.'}
                </p>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <>
          {/* Featured — the newest post, given the width its recency deserves. */}
          <a class="feat" href={`/blog/${featured.id}/`} data-cat={featured.data.cluster || 'Method'}>
            <div class="feat-i"><Icon name={iconFor(featured.data.cluster)} size={30} /></div>
            <div class="feat-body">
              <p class="feat-k">
                <span class="feat-badge">Latest</span>
                {featured.data.cluster && <span>{featured.data.cluster}</span>}
                <span>·</span>
                <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
                <span>·</span>
                <span>{readMins(featured.body)} min read</span>
              </p>
              <h2 class="feat-h">{featured.data.title}</h2>
              <p class="muted feat-d">{featured.data.description}</p>
              <span class="go">Read it <Icon name="arrow" size={13} /></span>
            </div>
          </a>

          {rest.length > 0 && (
            <div class="tilegrid posts">
              {rest.map((p) => (
                <a class="post tile" href={`/blog/${p.id}/`} data-cat={p.data.cluster || 'Method'}>
                  <span class="tile-i"><Icon name={iconFor(p.data.cluster)} size={20} /></span>
                  <span class="label muted post-cl">{p.data.cluster}</span>
                  <h3>{p.data.title}</h3>
                  <p class="muted post-d">{p.data.description}</p>
                  <p class="post-t muted">
                    <time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time>
                    <span> · {readMins(p.body)} min read</span>
                  </p>
                </a>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap news">
      <div>
        <p class="kicker dr-kicker">Newsletter</p>
        <h2>One email when it’s worth your time</h2>
        <p class="lead news-lead">No noise, no tips. Research, not advice.</p>
      </div>
      <form class="news-form" id="nlForm"
        data-url={site.supabase.url} data-key={site.supabase.anonKey} data-table={site.supabase.waitlistTable}>
        <input type="email" id="nlEmail" placeholder="you@email.com" required aria-label="Email address" />
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="btn" id="nlBtn">Subscribe</button>
      </form>
      <p class="news-msg" id="nlMsg" role="status" aria-live="polite"></p>
    </div>
  </section>
</Base>

<style>
  .ph-lead { max-width: 560px; }
  .beginner-path { display: flex; align-items: center; gap: 14px; padding: 16px 18px; background: var(--panel); border: var(--rule); text-decoration: none; margin-bottom: 24px; transition: background .18s ease, border-color .18s ease; }
  .beginner-mark { color: var(--up); }
  .beginner-copy { display: grid; gap: 3px; flex: 1; }
  .beginner-copy strong { font-size: 12px; }
  .beginner-copy small { font-size: 10px; color: var(--ink-2); line-height: 1.55; }
  @media (hover: hover) { .beginner-path:hover { background: var(--panel-2); border-color: var(--ink-1); } }
  .chips { display: flex; gap: 1.5px; background: var(--line); border: var(--rule); width: fit-content; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    font-weight: 700; padding: 10px 16px; background: var(--panel); border: 0; cursor: pointer; color: var(--ink-1);
  }
  .chip.on { background: var(--ink-1); color: var(--bg); }

  .empty { max-width: 620px; padding: 28px; }
  .empty h2 { margin: 14px 0 10px; }
  .empty-p { font-size: 11.5px; }
  .empty-wrap { display: grid; gap: 26px; }
  .planned { grid-template-columns: repeat(4, 1fr); }
  .card-d { font-size: 11px; margin: 8px 0 0; }

  /* FEATURED. Wide, iconed, and the only card on the page with a mark at 30px — the size does the
     hierarchy so the type does not have to shout. */
  .feat {
    display: grid; grid-template-columns: 90px 1fr; gap: 0;
    border: var(--rule); background: var(--panel); text-decoration: none; margin-bottom: 26px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .feat-i {
    display: flex; align-items: center; justify-content: center;
    background: var(--ink-1); color: var(--bg);
  }
  .feat-body { padding: 24px; }
  .feat-k {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0 0 10px;
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .feat-badge { background: var(--up); color: #fff; padding: 3px 7px; font-weight: 700; }
  .feat-h { font-size: 20px; margin: 0 0 10px; max-width: 26ch; }
  .feat-d { font-size: 12.5px; margin: 0 0 14px; max-width: 62ch; line-height: 1.7; }
  @media (hover: hover) {
    .feat:hover { transform: translateY(-2px); border-color: var(--ink-1); }
    .feat:hover .go .icn { transform: translateX(3px); }
  }

  .go {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em;
    text-transform: uppercase; font-weight: 700; color: var(--ink-1);
  }
  .go .icn { transition: transform 0.18s ease; }

  .posts { grid-template-columns: repeat(3, 1fr); }
  .post { text-decoration: none; }
  .post-cl { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }
  .post h3 { margin: 6px 0 8px; font-size: 13px; line-height: 1.45; }
  .post-d { font-size: 11px; flex: 1; margin: 0; line-height: 1.65; }
  .post-t { font-size: 9.5px; display: block; margin: 12px 0 0; }

  .news { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
  .dr-kicker { color: #8f8f88; }
  .news-lead { color: #c8c8c0; margin: 0; }
  .news-form { display: flex; gap: 8px; }
  .news-form input[type='email'] {
    font-family: var(--font-mono); font-size: 12px; padding: 12px 14px; min-width: 260px;
    background: #101314; border: 1.5px solid #3a3a37; color: var(--bg);
  }
  .news-form input[type='email']:focus { outline: none; border-color: var(--bg); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .news-msg { grid-column: 1 / -1; margin: 0; font-size: 11px; color: var(--up); min-height: 1em; }

  @media (max-width: 1000px) { .posts, .planned { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .posts, .planned { grid-template-columns: 1fr; }
    .news { grid-template-columns: 1fr; }
    .news-form { flex-wrap: wrap; }
    .news-form input[type='email'] { min-width: 0; flex: 1; }
    /* The icon rail becomes a top band on narrow screens rather than a squeezed column. */
    .feat { grid-template-columns: 1fr; }
    .feat-i { height: 64px; }
    .feat-h { font-size: 17px; }
  }
  /* The category chips are the only interactive control on the page and were 33px tall — under
     every published thumb minimum. They become 44px rows. Everything else here is a card
     description or a date, i.e. the text that decides whether a post gets opened. */
  @media (max-width: 720px) {
    .chip { font-size: 11.5px; padding: 0 16px; min-height: 44px; }
    .empty-p, .card-d, .post-d { font-size: 12.5px; }
    .feat-k, .go { font-size: 11px; }
    .feat-d { font-size: 13.5px; }
    .post-cl { font-size: 10.5px; }
    .post-t { font-size: 11px; }
    .news-msg { font-size: 12.5px; }
  }
</style>

<script>
  // Category filter (client-side, matches the handoff behaviour).
  document.querySelectorAll('.chip').forEach((c) => {
    c.addEventListener('click', () => {
      document.querySelectorAll('.chip').forEach((x) => x.classList.remove('on'));
      c.classList.add('on');
      const cat = (c as HTMLElement).dataset.cat;
      document.querySelectorAll('.post').forEach((p) => {
        const el = p as HTMLElement;
        el.style.display = cat === 'All' || el.dataset.cat === cat ? '' : 'none';
      });
    });
  });

  const f = document.getElementById('nlForm') as HTMLFormElement | null;
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById('nlMsg')!;
    const email = (document.getElementById('nlEmail') as HTMLInputElement).value.trim().toLowerCase();
    if ((f.querySelector('input[name="company"]') as HTMLInputElement)?.value) { msg.textContent = 'Subscribed ✓'; return; }
    const btn = document.getElementById('nlBtn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch(`${f.dataset.url}/rest/v1/${f.dataset.table}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: f.dataset.key || '',
          Authorization: `Bearer ${f.dataset.key}`,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({ email, source: 'blog' }),
      });
      const ok = res.ok || res.status === 201 || res.status === 409;
      msg.textContent = ok ? 'Subscribed ✓' : 'Something went wrong — try again.';
      // 409 is a duplicate email, which is a real person re-subscribing, not a conversion — the
      // signup already exists and counting it again would inflate the only number we have.
      if (res.ok || res.status === 201) {
        (window as any).hTrack?.('waitlist_submit', { source: 'blog' });
        f.reset();
      }
    } catch { msg.textContent = 'Something went wrong — try again.'; }
    btn.disabled = false;
  });
</script>
